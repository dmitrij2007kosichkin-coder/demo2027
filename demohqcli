#!/bin/bash
# HQ-CLI setup script (единый, без перезагрузки внутри скрипта,
#                     SSH-порт НЕ трогаем)
# Запускать с правами root.
#
# Логика:
#   - Шаг 1 (DNS) и шаг 2 (ввод в домен) — выполняются всегда.
#   - Если после шага 2 пользователь уже виден в системе (id hq) —
#     скрипт сразу идёт дальше (шаги 3+).
#   - Если НЕ виден — скрипт останавливается с инструкцией:
#     перезагрузиться и запустить скрипт ПОВТОРНО
#     (шаги 1–2 будут пропущены, выполнение продолжится с шага 3).

set -euo pipefail

# ============================================================
# Параметры
# ============================================================
CON_NAME="${CON_NAME:-Проводное подключение 1}"
DOMAIN="${DOMAIN:-au-team.irpo}"
DOMAIN_USER="${DOMAIN_USER:-hq}"
DOMAIN_PASS="${DOMAIN_PASS:-}"
NTP_SERVER="${NTP_SERVER:-172.16.1.1}"

SUDOERS="/etc/sudoers"
CHRONY_CONF="/etc/chrony.conf"

log()  { echo "[*] $*"; }
ok()   { echo "[OK] $*"; }
warn() { echo "[WARN] $*"; }
die()  { echo "[ERROR] $*" >&2; exit 1; }

# ============================================================
# Определяем режим: первый запуск или повторный
# ============================================================
USER_PRESENT=0
if id "$DOMAIN_USER" >/dev/null 2>&1; then
    USER_PRESENT=1
fi

# ============================================================
# 1. Отключение автоматического DNS в NetworkManager
# ============================================================
if [ "$USER_PRESENT" -eq 0 ]; then
    if nmcli -t -f NAME connection show | grep -Fxq "$CON_NAME"; then
        nmcli connection modify "$CON_NAME" ipv4.ignore-auto-dns yes
        nmcli connection up "$CON_NAME" || true
        ok "DNS auto ignored for '$CON_NAME'"
    else
        warn "Connection '$CON_NAME' not found. Available:"
        nmcli -t -f NAME connection show
        die "Set CON_NAME env var and re-run: CON_NAME='...' $0"
    fi
else
    log "User '$DOMAIN_USER' already present — skipping DNS/domain steps."
fi

# ============================================================
# 2. Ввод в домен
# ============================================================
if [ "$USER_PRESENT" -eq 0 ]; then
    if [ -z "$DOMAIN_PASS" ]; then
        read -rsp "Password for ${DOMAIN}\\${DOMAIN_USER}: " DOMAIN_PASS
        echo
    fi

    log "Joining domain ${DOMAIN} as ${DOMAIN_USER}..."
    if command -v system-auth >/dev/null 2>&1; then
        HOSTNAME_SHORT="$(hostname -s)"
        system-auth write ad "$DOMAIN" "$HOSTNAME_SHORT" "$DOMAIN_USER" "$DOMAIN_PASS"
    elif command -v join-ad >/dev/null 2>&1; then
        join-ad -U "${DOMAIN}\\${DOMAIN_USER}" -p "$DOMAIN_PASS"
    else
        die "Neither 'system-auth' nor 'join-ad' found. Install domain-join tooling."
    fi
    unset DOMAIN_PASS
    ok "Domain join command completed."

    if ! id "$DOMAIN_USER" >/dev/null 2>&1; then
        echo
        echo "============================================================"
        echo " Домен введён, но пользователь '$DOMAIN_USER' пока не виден."
        echo " Обычно требуется ПЕРЕЗАГРУЗКА."
        echo
        echo " Что делать:"
        echo "   1) reboot"
        echo "   2) после загрузки запустить этот же скрипт ещё раз:"
        echo "        $0"
        echo "      (шаги 1–2 будут автоматически пропущены,"
        echo "       выполнение продолжится с шага 3)"
        echo "============================================================"
        exit 0
    fi
    ok "User '$DOMAIN_USER' is visible immediately — continuing without reboot."
fi

# ============================================================
# 3. roleadd
# ============================================================
if roleadd "$DOMAIN_USER" wheel; then
    ok "roleadd $DOMAIN_USER wheel"
else
    die "roleadd failed"
fi

# ============================================================
# 4. /etc/sudoers — точечная правка
# ============================================================
BACKUP="/etc/sudoers.bak.$(date +%Y%m%d%H%M%S)"
cp -a "$SUDOERS" "$BACKUP"
ok "Backup: $BACKUP"

# --- 4.1 User_Alias WHEEL_USERS ---
NEW_USER_ALIAS='User_Alias WHEEL_USERS = %wheel, %AU-TEAM\\hq'

if grep -qE '^[[:space:]]*#*[[:space:]]*User_Alias[[:space:]]+WHEEL_USERS[[:space:]]*=' "$SUDOERS"; then
    sed -i -E "s|^[[:space:]]*#*[[:space:]]*User_Alias[[:space:]]+WHEEL_USERS[[:space:]]*=.*|${NEW_USER_ALIAS}|" "$SUDOERS"
else
    awk -v new="$NEW_USER_ALIAS" '
        /^[[:space:]]*User_Alias[[:space:]]+/ { last = NR }
        { lines[NR] = $0 }
        END {
            if (last == 0) { for (i=1;i<=NR;i++) print lines[i]; print new; exit }
            for (i=1;i<=NR;i++) { print lines[i]; if (i==last) print new }
        }
    ' "$SUDOERS" > "${SUDOERS}.tmp"
    mv "${SUDOERS}.tmp" "$SUDOERS"
fi
ok "User_Alias WHEEL_USERS set."

# --- 4.2 Cmnd_Alias SHELLCMD (устойчиво к числу Cmnd_Alias) ---
NEW_CMND='Cmnd_Alias SHELLCMD = /usr/bin/id, /usr/bin/cat, /bin/grep'

sed -i -E '/^[[:space:]]*#*[[:space:]]*Cmnd_Alias[[:space:]]+SHELLCMD[[:space:]]*=/d' "$SUDOERS"

awk -v new="$NEW_CMND" '
    /^[[:space:]]*Cmnd_Alias[[:space:]]+/ && $0 !~ /SHELLCMD/ { last = NR }
    /^[[:space:]]*Cmnd_Alias[[:space:]]+PKGMAN[[:space:]]*=/ { pkgman = NR }
    { lines[NR] = $0 }
    END {
        target = (pkgman > 0) ? pkgman : last
        if (target == 0) {
            print "ERROR: no Cmnd_Alias found in sudoers" > "/dev/stderr"
            exit 1
        }
        for (i = 1; i <= NR; i++) {
            print lines[i]
            if (i == target) print new
        }
    }
' "$SUDOERS" > "${SUDOERS}.tmp" || { rm -f "${SUDOERS}.tmp"; die "awk failed while inserting SHELLCMD"; }

if ! grep -qE '^[[:space:]]*Cmnd_Alias[[:space:]]+SHELLCMD[[:space:]]*=' "${SUDOERS}.tmp"; then
    rm -f "${SUDOERS}.tmp"
    die "SHELLCMD not inserted — aborting, no changes applied"
fi
mv "${SUDOERS}.tmp" "$SUDOERS"
ok "Cmnd_Alias SHELLCMD inserted."

# --- 4.3 Правило WHEEL_USERS (только первая строка) ---
if grep -qE '^[[:space:]]*#*[[:space:]]*WHEEL_USERS[[:space:]]+ALL[[:space:]]*=' "$SUDOERS"; then
    sed -i '0,/^[[:space:]]*#*[[:space:]]*WHEEL_USERS[[:space:]]\+ALL[[:space:]]*=/s//WHEEL_USERS ALL=(ALL:ALL) SHELLCMD/' "$SUDOERS"
else
    sed -i -E '/^[[:space:]]*User_Alias[[:space:]]+WHEEL_USERS[[:space:]]*=/a WHEEL_USERS ALL=(ALL:ALL) SHELLCMD' "$SUDOERS"
fi
ok "Rule WHEEL_USERS ALL=(ALL:ALL) SHELLCMD set."

# --- 4.4 Проверка синтаксиса всего дерева sudoers ---
if visudo -c >/dev/null 2>&1; then
    ok "sudoers validated (visudo -c)"
else
    warn "sudoers syntax error — restoring backup"
    visudo -c || true
    cp -a "$BACKUP" "$SUDOERS"
    die "sudoers restored from backup"
fi

# ============================================================
# 5. Chrony
# ============================================================
if [ -f "$CHRONY_CONF" ]; then
    sed -i -E '/^[[:space:]]*(server|pool)[[:space:]]+/d' "$CHRONY_CONF"
    [ -n "$(tail -c1 "$CHRONY_CONF")" ] && echo >> "$CHRONY_CONF"
    echo "pool $NTP_SERVER iburst" >> "$CHRONY_CONF"

    timedatectl set-ntp false 2>/dev/null || true
    systemctl enable chronyd
    systemctl restart chronyd
    ok "Chrony configured with pool $NTP_SERVER"
else
    warn "$CHRONY_CONF not found — skipping chrony setup"
fi

# ============================================================
# 6. Yandex Browser
# ============================================================
apt-get update -y || true
if apt-get install -y yandex-browser-stable; then
    ok "yandex-browser-stable installed"
elif apt-get install -y yandex-browser; then
    ok "yandex-browser installed"
else
    warn "Could not install Yandex Browser"
fi

# ============================================================
# 7. Информация о дисках
# ============================================================
echo "=== /etc/fstab ==="
cat /etc/fstab || true
echo
echo "=== df -h ==="
df -h || true

echo
echo "============================================================"
echo " Настройка завершена."
echo "============================================================"
